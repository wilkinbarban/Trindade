# ============================================================
# Trindade API — Docker Build
# ============================================================
FROM node:24-bookworm-slim AS builder

WORKDIR /app

# No build toolchain is installed on purpose. better-sqlite3@13 is N-API and ships
# its prebuilt binaries inside the package (`prebuilds/**`); it declares no install
# script, so npm would inject a default `node-gyp rebuild` that needs python3 just to
# read binding.gyp. `allowScripts` in the root package.json records an explicit
# denial for it, and lib/binding.js resolves the prebuild at require time. Without a
# toolchain a missing prebuild fails the build loudly instead of compiling a binary
# against the running Node headers (the defect documented in README.md).

# Copy workspace-level config (npm workspaces needs root package.json)
COPY package.json package-lock.json tsconfig.base.json ./

# Copy backend package metadata.  Only the backend workspace exists here,
# so npm ci will only install backend dependencies (no frontend bloat).
COPY packages/backend/package.json packages/backend/
COPY packages/backend/tsconfig.json packages/backend/tsconfig.build.json packages/backend/

RUN npm ci

# Copy backend source
COPY packages/backend/src packages/backend/src/

# Build TypeScript → dist/
WORKDIR /app/packages/backend
RUN npm run build

# ============================================================
# Runner stage — minimal production image
# ============================================================
FROM node:24-bookworm-slim AS runner

WORKDIR /app

# No python3 either: better-sqlite3 loads its shipped prebuilt native binary, so
# nothing compiles or interprets SQLite bindings at runtime.

# Copy compiled output and runtime dependencies
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages/backend/dist /app/packages/backend/dist

# Copy SQL files alongside compiled JS (they are read at startup)
COPY --from=builder /app/packages/backend/src/db/schema.sql /app/packages/backend/dist/db/schema.sql
COPY --from=builder /app/packages/backend/src/db/seed.sql  /app/packages/backend/dist/db/seed.sql

# Mount point for SQLite data volume and photo storage
RUN mkdir -p /app/packages/backend/data/photos

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "packages/backend/dist/server.js"]
