# ============================================================
# Trindade Massas — Host Nginx Configuration Template
# For standalone VPS deployment with host Nginx + Certbot.
#
# Reverse proxies HTTPS traffic from trindademasas.duckdns.org
# to the local Trindade web container listening on 127.0.0.1:8080.
# ============================================================

# ------------------------------------------------------------
# STEP 1 (Initial Bootstrap — HTTP only)
# ------------------------------------------------------------
# Before SSL certificates exist, activate only this HTTP block to allow
# Certbot to complete the webroot challenge:
#
#   sudo mkdir -p /var/www/certbot
#   sudo certbot certonly --webroot -w /var/www/certbot -d trindademasas.duckdns.org
# ------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name trindademasas.duckdns.org;

    # ACME challenge for Let's Encrypt / Certbot renewal
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------
# STEP 2 (Production HTTPS — Enable after certificates exist)
# ------------------------------------------------------------
# Once certificates are issued at /etc/letsencrypt/live/trindademasas.duckdns.org/,
# uncomment the HTTPS block below (remove '# ') and reload Nginx:
#   sudo sed -i 's/^# server {/server {/; s/^#     /    /; s/^# }/}/' /etc/nginx/sites-available/trindademasas
#   sudo nginx -t && sudo systemctl reload nginx
# ------------------------------------------------------------

