# ============================================================
# Trindade Massas — Environment Variables
# Copy to .env and adjust for your deployment.
# ============================================================

# Required JWT signing secret. Generate a unique value; never reuse test/default values.
# Example generator: openssl rand -hex 32
JWT_SECRET=

# Installation identity. A missing target is initialized; an established target is
# opened read-only during stage one; ambiguous targets fail before mutation.
DATABASE_PATH=/app/packages/backend/data/trindade.db

# Associated files covered by recovery inventory and fingerprint checks.
PHOTOS_DIR=/app/packages/backend/data/photos

# API server
PORT=3000
HOST=0.0.0.0

# Web frontend port (for docker-compose)
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_PORT=3000

# Public API base URL used in WhatsApp photo links. Set this to your real domain in production.
PUBLIC_APP_URL=https://trindademasas.duckdns.org

# Optional Google Cloud Translation API key. Leave blank unless translation is enabled.
GOOGLE_TRANSLATE_API_KEY=
VITE_APP_BASE=/
