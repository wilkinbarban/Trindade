# Ignore rules are deliberately unanchored where the artifact can exist at any
# depth, as with node_modules/, dist/, .env, test-results/, *.db and *.log: each
# package owns its own copy. Anchor a rule to the repository root only when a
# nested artifact of the same name must stay versionable, as with /.pi/.

# SDD local artifacts
.atl/

# Android release signing. keystore.properties holds the store password in plain text and the
# keystore is the one file that can never be regenerated, so neither may ever be tracked at any depth;
# the unanchored rules follow the convention at the top of this file. Ignoring a keystore is not
# permission to keep one in the tree: docs/release-android.md keeps it outside the repository.
keystore.properties
*.jks
*.keystore
*.p12
*.pfx

# Local recovery and diagnostic artifacts
.git-index-safety/

# Dependencies
node_modules/

# Build
dist/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# SQLite
*.db
*.db-journal
*.db-shm
*.db-wal

# Logs
*.log

# Test artifacts
test-results/

# Local Pi / gentle-ai session state. Anchored to the repository root: an
# unanchored .pi/ would also swallow gentle-ai state in any nested package.
/.pi/

# Local recovery sets
backups/

# Runtime state — SQLite database, WAL sidecars and uploaded report photos.
# The directory itself is kept in git via .gitkeep so a fresh clone can boot.
packages/backend/data/*
!packages/backend/data/.gitkeep
