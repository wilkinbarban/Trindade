<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY, and that is the point: this file lives under src/debug/, so it is never merged into a
  release build. A shipped APK therefore carries no cleartext exception at all and the platform
  default applies, which since API 28 is that cleartext is forbidden.

  It exists because the development default base URL is http://10.0.2.2:3000/, and cleartext to that
  host is blocked without an exception here. The symptom of omitting it is not a policy error: the
  request fails as an opaque socket error that reads like a network problem, which is why this is
  configured rather than left to be discovered.

  10.0.2.2 is the Android emulator's alias for the host loopback. localhost and 127.0.0.1 cover a
  physical device reaching a backend through `adb reverse`. Nothing else is exempt: to test against
  a backend on a LAN address, add that host deliberately, and prefer port-forwarding over widening
  this list.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
