<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY, and that is the point: this file lives under src/debug/, so it is never merged into a
  release build. A release APK carries src/main/res/xml/network_security_config.xml instead, which
  exempts exactly one host, the plant's WebService, and nothing else.

  Two sets of hosts, and they answer two different questions:

  - 10.0.2.2 is the emulator's alias for the host loopback, and localhost/127.0.0.1 cover a physical
    device reaching a backend through `adb reverse`. They exist because the development default base URL
    is http://10.0.2.2:3000/ and cleartext to that host is blocked without an exemption; the symptom of
    omitting it is not a policy error but an opaque socket error that reads like a network problem.
  - 192.168.25.250 is the factory's ERP. It is repeated here because this file overrides the one in
    src/main/ rather than being merged with it, and a debug build that cannot reach the plant would make
    the native integration untestable on the only network where it works.

  Nothing else is exempt: to test against a backend on another LAN address, add that host deliberately,
  and prefer port-forwarding over widening this list.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.25.250</domain>
    </domain-config>
</network-security-config>
