<?xml version="1.0" encoding="utf-8"?>
<!--
  The directories external apps are allowed to access on this app's behalf via FileProvider.

  Scoped to the cache rather than the whole app: temporary captures and exports live here,
  and granting access to anything else would be handing external apps the token store's
  neighbourhood for no reason.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <cache-path name="exports" path="exports/" />
</paths>
