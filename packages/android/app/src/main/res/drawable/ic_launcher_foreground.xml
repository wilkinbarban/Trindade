<?xml version="1.0" encoding="utf-8"?>
<!--
  Variant F launcher mark ("cinta dinâmica") wired for Android's adaptive icon.

  The mark is inset to the central 72x72 safe zone of the 108x108 adaptive icon canvas
  (18dp margins on all four sides). This guarantees that neither circular, squircle,
  nor rounded-square system masks clip any part of the launcher mark.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_f"
    android:inset="18dp"
    android:insetLeft="18dp"
    android:insetTop="18dp"
    android:insetRight="18dp"
    android:insetBottom="18dp" />
