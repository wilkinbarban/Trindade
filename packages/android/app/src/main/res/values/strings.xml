<resources>
    <string name="app_name">Trindade</string>

    <!-- Portuguese because the operators are: the app's own copy is the only text here that the
         server did not write, and it is the same language the API answers in. -->
    <string name="login_title">Trindade Massas</string>
    <string name="login_username">Usuário</string>
    <string name="login_password">Senha</string>
    <string name="login_submit">Entrar</string>
    <string name="login_unreachable">Sem conexão com o servidor. Verifique a rede e tente de novo.</string>

    <string name="report_submit">Salvar relatório</string>
    <string name="report_created">Relatório %1$d salvo.</string>
    <string name="report_back">Voltar</string>
    <string name="report_photos">Fotos (%1$d/%2$d)</string>
    <string name="report_photo_add">Tirar foto</string>
    <string name="report_photo_remove">Remover</string>
    <!-- Shared by both export surfaces: the text is the server's WhatsApp message either way, so the
         sentence lives once and neither screen owns the other's name. -->
    <string name="export_load">Gerar texto do WhatsApp</string>
    <string name="export_copy">Copiar texto</string>

    <!-- The history of the reports this surface produces. Its own door is on the generator rather than
         in a third tab, so the action there is named for where it goes and not for the tab it is not.
         The word is shared with the loading history's own door, which makes the same choice on the
         grid for the same reason: both histories list what their surface produces, so the way in is an
         action on that surface. The two screens' filter, paging and lifecycle words are shared below
         for the same reason, since they name the same controls, while the sentences that name a report
         or a batch are each screen's own. -->
    <string name="report_history">Histórico</string>
    <string name="history_title">Histórico de relatórios</string>
    <string name="history_all_reports">Todos os relatórios</string>
    <string name="history_filtered">Relatórios de %1$s</string>
    <string name="history_filter_day">Dia</string>
    <string name="history_filter_month">Mês</string>
    <string name="history_filter_day_value">Dia: %1$s</string>
    <string name="history_filter_month_value">Mês: %1$s</string>
    <string name="history_clear_filters">Limpar</string>
    <string name="history_month_picker_title">Escolha o mês</string>
    <string name="history_turno_tarde">Tarde</string>
    <string name="history_turno_noite">Noite</string>
    <string name="history_inactive">Inativo</string>
    <string name="history_deactivate">Desativar</string>
    <string name="history_delete">Excluir</string>
    <!-- The only action on this screen that asks twice: the deletion is irreversible on the server. -->
    <string name="history_delete_confirm_title">Excluir este relatório?</string>
    <string name="history_delete_confirm_body">Não dá para desfazer: ele sai para todo mundo, não só desta tela.</string>
    <string name="history_empty">Nenhum relatório encontrado para este período.</string>
    <string name="history_pagination">Página %1$d de %2$d (%3$d registros)</string>
    <string name="history_previous">Anterior</string>
    <string name="history_next">Próxima</string>

    <!-- The loading history. One row is one batch, meaning a day's entries rather than one entry, so
         the copy that names what a row is belongs to this screen; the words shared with the report
         history above are the ones that name a control rather than a thing. -->
    <string name="loading_history_title">Histórico de carregamentos</string>
    <string name="loading_history_all">Todos os carregamentos</string>
    <string name="loading_history_filtered">Carregamentos de %1$s</string>
    <!-- Labelled, because the loading date is not the batch date above it on six days out of seven. -->
    <string name="loading_history_loading_date">Carregamento: %1$s</string>
    <string name="loading_history_loadings">%1$d carregamentos</string>
    <string name="loading_history_empty">Nenhum carregamento encontrado para este período.</string>
    <!-- The batch's own date, so the confirmation names the day the operator is about to lose. -->
    <string name="loading_history_delete_confirm_title">Excluir o carregamento de %1$s?</string>
    <string name="loading_history_delete_confirm_body">Não dá para desfazer: todos os lançamentos desse dia saem para todo mundo, não só desta tela.</string>

    <string name="nav_reports">Relatórios</string>
    <string name="nav_loading">Horários</string>

    <!-- The account. Its entry point is not a third tab: it sits at the far end of the tab row, because
         the two tabs are the app's jobs and this is who the operator is. The labels are the words the
         desktop screen uses for the same fields, since the operators read both. -->
    <string name="profile_title">Perfil</string>
    <string name="profile_account">Conta</string>
    <string name="profile_username">Usuário</string>
    <string name="profile_display_name">Nome</string>
    <string name="profile_role">Função</string>
    <!-- The two roles the database has. The contract types `role` as a bare string, so an unknown value
         is shown as it arrived rather than as one of these two. -->
    <string name="profile_role_administrator">Administrador</string>
    <string name="profile_role_worker">Trabalhador</string>
    <string name="profile_save">Salvar</string>
    <string name="profile_name_saved">Nome atualizado.</string>
    <!-- One string for the block and for the action that sends it: both name the same thing. -->
    <string name="profile_change_password">Alterar senha</string>
    <string name="profile_current_password">Senha atual</string>
    <string name="profile_new_password">Nova senha</string>
    <!-- The server's minimum, stated where the password is typed instead of discovered as a 400. The
         number is the view model's constant, so the rule and the sentence cannot drift apart. -->
    <string name="profile_password_rule">A nova senha precisa de pelo menos %1$d caracteres.</string>
    <!-- No confirmation accompanies this action: see the screen for why it does not ask twice. -->
    <string name="profile_sign_out">Sair da conta</string>
    <!-- Shown in place of the form once the session has ended. The password change brings its own
         sentence, because that sign-out is one the operator did not ask for. -->
    <string name="profile_signed_out">Sessão encerrada.</string>
    <string name="profile_back_to_login">Entrar de novo</string>
    <string name="loading_title">Cronograma de carregamento</string>
    <string name="loading_fleteros">%1$d/%2$d fleteros</string>
