{
  "name": "@trindade/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/db/*.sql dist/db/",
    "start": "node dist/server.js",
    "db:reset": "rm -f data/trindade.db",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e:server": "tsx src/e2e-server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
